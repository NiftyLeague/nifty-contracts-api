ETHERSCAN_API_KEY=""
ALCHEMY_API_KEY=""
INFURA_PROJECT_ID=""
INFURA_AUTHORIZATION_DEV=""
INFURA_AUTHORIZATION_PROD=""

WEBHOOK_SECRET=""
BLOCKNATIVE_API_KEY_COMICS=""
BLOCKNATIVE_API_KEY_DEGENS=""
BLOCKNATIVE_API_KEY_P2E=""

BE_API_SECRET=""

S3_ACCESS_ID=""
S3_SECRET=""

UNITY_IMAGE_GENERATOR_BASE_URL=""
UNITY_IMAGE_GENERATOR_SECRET=""
