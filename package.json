{
  "name": "@niftyleague/contracts-api",
  "version": "1.0.0",
  "description": "Nifty League Contracts API & Webhooks",
  "repository": "github:NiftyLeague/ContractsAPI.git",
  "type": "module",
  "main": "dist/api/index.js",
  "bin": {
    "minty": "commander.ts"
  },
  "scripts": {
    "build": "npx tsc && tsc-alias",
    "start": "node dist/api/index.js",
    "postinstall": "node-config-ts",
    "dev": "tsx watch api/index.ts",
    "test": "tsx api/index.test.ts",
    "lint": "eslint --ignore-path .eslintignore . --ext .ts,.js",
    "format": "prettier --ignore-path .prettierignore --write .",
    "type-check": "tsc --noEmit",
    "onboarding:user-registration": "tsx ./api/imx/onboarding/1-user-registration.ts",
    "onboarding:create-project": "tsx ./api/imx/onboarding/2-create-project.ts",
    "onboarding:create-collection": "tsx ./api/imx/onboarding/3-create-collection.ts",
    "onboarding:add-metadata-schema": "tsx ./api/imx/onboarding/4-add-metadata-schema.ts",
    "admin:update-metadata-schema": "tsx ./api/imx/admin/update-metadata-schema.ts"
  },
  "author": "Nifty Andy",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/lib-storage": "^3.540.0",
    "@imtbl/core-sdk": "^2.7.0",
    "@imtbl/imlogging": "^1.0.37",
    "@imtbl/imx-sdk": "^3.8.0",
    "@pinata/sdk": "^2.1.0",
    "bn.js": "^5.2.1",
    "body-parser": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "enc-utils": "^3.0.0",
    "ethers": "^6.11.1",
    "express": "^4.19.2",
    "https": "^1.0.0",
    "ipfs-core-types": "^0.14.0",
    "ipfs-http-client": "^60.0.1",
    "json-colorizer": "^2.2.2",
    "lodash-es": "^4.17.21",
    "node-config-ts": "^3.3.1",
    "node-fetch": "^3.3.2",
    "ts-command-line-args": "^2.5.1",
    "uint8arrays": "^5.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.12.2",
    "@types/node-fetch": "^2.6.11",
    "@types/request": "^2.48.12",
    "@types/tape": "^5.6.4",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "commander": "^12.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "request": "^2.88.2",
    "tape": "^5.7.5",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22"
}
