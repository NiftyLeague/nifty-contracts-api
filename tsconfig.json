{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["./api/**/*.ts", "./config/**/*.ts"],
  "files": ["./hardhat.config.ts", "./commander.ts"],
  "exclude": ["node_modules"]
}
