{
  "name": "@niftyleague/contracts-api",
  "version": "1.0.0",
  "description": "Nifty League Contracts API & Webhooks",
  "repository": "github:NiftyLeague/ContractsAPI.git",
  "type": "module",
  "main": "dist/api/index.js",
  "bin": {
    "minty": "commander.ts"
  },
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/api/index.js",
    "postinstall": "npm run build",
    "dev": "tsx watch api/index.ts",
    "test": "tsx api/index.test.ts",
    "lint": "eslint --ignore-path .eslintignore . --ext .ts,.js",
    "format": "prettier --ignore-path .prettierignore --write .",
    "onboarding:user-registration": "tsx -r tsconfig-paths/register -r dotenv/config ./api/imx/onboarding/1-user-registration.ts",
    "onboarding:create-project": "tsx -r tsconfig-paths/register -r dotenv/config ./api/imx/onboarding/2-create-project.ts",
    "onboarding:create-collection": "tsx -r tsconfig-paths/register -r dotenv/config ./api/imx/onboarding/3-create-collection.ts",
    "onboarding:add-metadata-schema": "tsx -r tsconfig-paths/register -r dotenv/config ./api/imx/onboarding/4-add-metadata-schema.ts",
    "admin:update-metadata-schema": "tsx -r tsconfig-paths/register -r dotenv/config ./api/imx/admin/update-metadata-schema.ts"
  },
  "author": "Nifty Andy",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/lib-storage": "^3.540.0",
    "@imtbl/core-sdk": "^2.7.0",
    "@imtbl/imlogging": "^1.0.37",
    "@imtbl/imx-sdk": "^3.8.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.6",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.10",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.5",
    "@pinata/sdk": "^2.1.0",
    "bn.js": "^5.2.1",
    "body-parser": "^1.20.0",
    "config": "^3.3.11",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "enc-utils": "^3.0.0",
    "ethers": "^6.11.1",
    "express": "^4.19.2",
    "hardhat": "^2.22.2",
    "https": "^1.0.0",
    "ipfs-core-types": "^0.14.0",
    "ipfs-http-client": "^60.0.1",
    "json-colorizer": "^2.2.2",
    "lodash": "^4.17.21",
    "node-fetch": "^3.3.2",
    "ts-command-line-args": "^2.5.1",
    "uint8arrays": "^5.0.3"
  },
  "devDependencies": {
    "@typechain/hardhat": "^9.1.0",
    "@types/config": "^3.3.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.11.30",
    "@types/node-fetch": "^2.6.11",
    "@types/request": "^2.48.12",
    "@types/tape": "^5.6.4",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "chai": "^5.1.0",
    "commander": "^12.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "hardhat-gas-reporter": "^2.0.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "request": "^2.88.2",
    "solidity-coverage": "^0.8.11",
    "tape": "^5.7.5",
    "tsconfig-paths": "^4.1.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22"
}
