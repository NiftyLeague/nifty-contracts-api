{
  "name": "@niftyleague/contracts-api",
  "version": "1.0.0",
  "description": "Nifty League Contracts API & Webhooks",
  "repository": "github:NiftyLeague/ContractsAPI.git",
  "author": "Nifty Andy",
  "license": "MIT",
  "type": "module",
  "main": "dist/api/index.js",
  "bin": {
    "minty": "commander.ts"
  },
  "scripts": {
    "build": "npx tsc && tsc-alias",
    "start": "node dist/api/index.js",
    "dev": "tsx watch api/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "lint": "eslint --ignore-path .eslintignore . --ext .ts,.js",
    "format": "prettier --ignore-path .prettierignore --write .",
    "type-check": "tsc --noEmit",
    "update-env": "node-config-ts && prettier --write config/*.ts",
    "onboarding:user-registration": "tsx api/imx/onboarding/1-user-registration.ts",
    "onboarding:create-project": "tsx api/imx/onboarding/2-create-project.ts",
    "onboarding:create-collection": "tsx api/imx/onboarding/3-create-collection.ts",
    "onboarding:add-metadata-schema": "tsx api/imx/onboarding/4-add-metadata-schema.ts",
    "admin:update-metadata-schema": "tsx api/imx/admin/update-metadata-schema.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.592.0",
    "@aws-sdk/lib-storage": "^3.550.0",
    "@imtbl/imx-sdk": "^3.8.0",
    "@pinata/sdk": "^2.1.0",
    "axios": "^1.6.8",
    "bn.js": "^5.2.1",
    "body-parser": "^1.20.2",
    "cids": "^1.1.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "enc-utils": "^3.0.0",
    "ethers": "^6.11.1",
    "express": "^4.19.2",
    "https": "^1.0.0",
    "ipfs-core-types": "^0.14.1",
    "ipfs-http-client": "^60.0.1",
    "json-colorizer": "^2.2.2",
    "lodash-es": "^4.17.21",
    "node-config-ts": "^3.3.1",
    "node-fetch": "^3.3.2",
    "ts-command-line-args": "^2.5.1",
    "uint8arrays": "^5.0.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.12.5",
    "@types/node-fetch": "^2.6.11",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.2",
    "typescript": "^5.4.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.15.6+sha256.01c01eeb990e379b31ef19c03e9d06a14afa5250b82e81303f88721c99ff2e6f"
}
