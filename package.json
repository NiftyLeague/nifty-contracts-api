{
  "name": "metadata-api-nodejs",
  "version": "1.0.0",
  "description": "API for Game Account webhooks",
  "repository": "github:NiftyLeague/metadata-api-nodejs.git",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/index.js",
    "postinstall": "npm run build",
    "dev": "concurrently \"npx tsc --watch\" \"nodemon -q dist/index.js\"",
    "test": "ts-node test.ts",
    "onboarding:user-registration": "ts-node -r tsconfig-paths/register -r dotenv/config ./imx-mint/onboarding/1-user-registration.ts",
    "onboarding:create-project": "ts-node -r tsconfig-paths/register -r dotenv/config ./imx-mint/onboarding/2-create-project.ts",
    "onboarding:create-collection": "ts-node -r tsconfig-paths/register -r dotenv/config ./imx-mint/onboarding/3-create-collection.ts",
    "onboarding:add-metadata-schema": "ts-node -r tsconfig-paths/register -r dotenv/config ./imx-mint/onboarding/4-add-metadata-schema.ts"
  },
  "author": "Nifty Andy",
  "license": "MIT",
  "dependencies": {
    "@ethersproject/abstract-signer": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@imtbl/core-sdk": "^1.0.0-beta.3",
    "@imtbl/imlogging": "^1.0.37",
    "@imtbl/imx-sdk": "^1.35.2",
    "@nomicfoundation/hardhat-toolbox": "^1.0.2",
    "@nomiclabs/hardhat-ethers": "^2.0.5",
    "@types/node-fetch": "^2.6.2",
    "aws-sdk": "^2.1260.0",
    "bn.js": "^5.2.1",
    "body-parser": "^1.20.0",
    "chalk": "^4.1.2",
    "config": "^3.3.8",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "ejs": "^3.1.8",
    "enc-utils": "^3.0.0",
    "ethers": "^5.7.2",
    "express": "^4.18.2",
    "hardhat": "^2.12.2",
    "https": "^1.0.0",
    "ipfs-http-client": "^59.0.0",
    "it-all": "^2.0.0",
    "json-colorizer": "^2.2.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "node-fetch": "^2.6.7",
    "uint8arrays": "^3.0.0",
    "web3": "^1.7.3"
  },
  "devDependencies": {
    "@types/config": "^3.3.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.14",
    "@types/lodash": "^4.14.189",
    "@types/node": "^18.11.9",
    "@types/node-fetch": "^2.6.2",
    "@types/request": "^2.48.8",
    "@types/tape": "^4.13.2",
    "@typescript-eslint/eslint-plugin": "^5.42.1",
    "@typescript-eslint/parser": "^5.50.0",
    "concurrently": "^7.5.0",
    "eslint": "^8.33.0",
    "fp-ts": "^2.13.1",
    "nodemon": "^2.0.20",
    "request": "^2.88.2",
    "tape": "^4.16.1",
    "ts-migrate": "^0.1.35",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^4.8.4"
  },
  "engines": {
    "node": "16.18.1",
    "npm": "8.19.2"
  }
}
