{
  "host": {
    "mainnet": "https://api.niftyleague.com",
    "sepolia": "https://niftyleague-dev.herokuapp.com"
  },
  "port": "@@PORT",
  "secret": "@@BE_API_SECRET",
  "blocknative": {
    "apiKey": {
      "comics": "@@BLOCKNATIVE_API_KEY_COMICS",
      "degens": "@@BLOCKNATIVE_API_KEY_DEGENS",
      "p2e": "@@BLOCKNATIVE_API_KEY_P2E"
    },
    "webhookSecret": "@@WEBHOOK_SECRET"
  },
  "eth": {
    "pk": "@@OWNER_ACCOUNT_PRIVATE_KEY",
    "network": "@@ETH_NETWORK",
    "infura": "@@INFURA_PROJECT_ID",
    "etherscan": "@@ETHERSCAN_API_KEY",
    "alchemy": "@@ALCHEMY_API_KEY",
    "opensea": "@@OPENSEA_API_KEY"
  },
  "imx": {
    "client": {
      "publicApiUrl": "@@PUBLIC_API_URL",
      "starkContractAddress": "@@STARK_CONTRACT_ADDRESS",
      "registrationContractAddress": "@@REGISTRATION_ADDRESS",
      "gasLimit": "@@GAS_LIMIT",
      "gasPrice": "@@GAS_PRICE",
      "enableDebug": true
    },
    "owner": {
      "address": "@@OWNER_ACCOUNT_ADDRESS",
      "publicKey": "@@OWNER_ACCOUNT_PUBLIC_KEY",
      "pk": "@@OWNER_ACCOUNT_PRIVATE_KEY"
    },
    "company": {
      "name": "Nifty League",
      "contact": "info@niftyleague.com"
    },
    "project": {
      "name": "Nifty League: Marketplace"
    },
    "collection": {
      "contractAddress": "@@COLLECTION_CONTRACT_ADDRESS",
      "name": "Nifty League: Items",
      "description": "A collection of unique and rare items used in Nifty League games.",
      "projectId": "@@COLLECTION_PROJECT_ID"
    }
  },
  "imageGenerator": {
    "baseURL": "@@UNITY_IMAGE_GENERATOR_BASE_URL",
    "secret": "@@UNITY_IMAGE_GENERATOR_SECRET",
    "version": "@@UNITY_IMAGE_GENERATOR_VERSION"
  },
  "s3": {
    "bucket": "nifty-league",
    "clientConfig": {
      "region": "us-east-1",
      "credentials": {
        "accessKeyId": "@@S3_ACCESS_ID",
        "secretAccessKey": "@@S3_SECRET"
      }
    }
  },
  "ipfs": {
    "authorization": "@@NFT_STORAGE_KEY",
    "protocol": "https",
    "host": "api.nft.storage",
    "port": 5001,
    "path": "",
    "gatewayURL": "https://ipfs.io/ipfs",
    "pinata": {
      "pinataApiKey": "@@PINATA_API_KEY",
      "pinataSecretApiKey": "@@PINATA_API_SECRET"
    }
  }
}
