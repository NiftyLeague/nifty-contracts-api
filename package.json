{
  "name": "@niftyleague/contracts-api",
  "version": "1.0.0",
  "description": "Nifty League Contracts API & Webhooks",
  "repository": "github:NiftyLeague/ContractsAPI.git",
  "author": "Nifty Andy",
  "license": "MIT",
  "type": "module",
  "main": "dist/api/index.js",
  "bin": {
    "minty": "commander.ts"
  },
  "scripts": {
    "build": "npx tsc && tsc-alias",
    "start": "node dist/api/index.js",
    "dev": "tsx watch api/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --ignore-path .prettierignore --write .",
    "type-check": "tsc --noEmit",
    "update-env": "node-config-ts && prettier --write config/*.ts",
    "onboarding:user-registration": "tsx api/imx/onboarding/1-user-registration.ts",
    "onboarding:create-project": "tsx api/imx/onboarding/2-create-project.ts",
    "onboarding:create-collection": "tsx api/imx/onboarding/3-create-collection.ts",
    "onboarding:add-metadata-schema": "tsx api/imx/onboarding/4-add-metadata-schema.ts",
    "admin:update-metadata-schema": "tsx api/imx/admin/update-metadata-schema.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.946.0",
    "@aws-sdk/lib-storage": "^3.946.0",
    "@imtbl/imx-sdk": "^3.8.2",
    "@pinata/sdk": "^2.1.0",
    "axios": "^1.13.2",
    "bn.js": "^5.2.2",
    "body-parser": "^2.2.1",
    "cids": "^1.1.9",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "enc-utils": "^3.0.0",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "https": "^1.0.0",
    "ipfs-core-types": "^0.14.1",
    "ipfs-http-client": "^60.0.1",
    "json-colorizer": "^3.0.1",
    "lodash-es": "^4.17.21",
    "node-config-ts": "^3.3.1",
    "node-fetch": "^3.3.2",
    "ts-command-line-args": "^2.5.1",
    "uint8arrays": "^5.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.49.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "engines": {
    "node": "24.11.1"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
