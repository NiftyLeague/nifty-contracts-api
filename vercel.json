{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.mjs",
  "env": {
    "NODE_CONFIG_TS_DIR": "dist/config"
  },
  "functions": {
    "api/index.js": {
      "includeFiles": "config/**,dist/**",
      "excludeFiles": "assets/**",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
