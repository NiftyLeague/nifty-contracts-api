{
  "name": "@niftyleague/nifty-contracts-api",
  "version": "1.0.0",
  "description": "Nifty League Contracts API & Webhooks",
  "repository": "github:NiftyLeague/nifty-contracts-api.git",
  "author": "Nifty Andy",
  "license": "MIT",
  "type": "module",
  "main": "dist/api/index.js",
  "bin": {
    "minty": "commander.ts"
  },
  "scripts": {
    "build": "npx tsc && tsc-alias",
    "start": "node dist/api/index.js",
    "dev": "tsx watch api/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "lint": "eslint .",
    "format": "prettier --ignore-path .prettierignore --write .",
    "type-check": "tsc --noEmit",
    "update-env": "node-config-ts && prettier --write config/*.ts",
    "onboarding:user-registration": "tsx api/imx/onboarding/1-user-registration.ts",
    "onboarding:create-project": "tsx api/imx/onboarding/2-create-project.ts",
    "onboarding:create-collection": "tsx api/imx/onboarding/3-create-collection.ts",
    "onboarding:add-metadata-schema": "tsx api/imx/onboarding/4-add-metadata-schema.ts",
    "admin:update-metadata-schema": "tsx api/imx/admin/update-metadata-schema.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/lib-storage": "^3.1087.0",
    "@imtbl/imx-sdk": "^3.8.2",
    "@pinata/sdk": "^2.1.0",
    "axios": "^1.18.1",
    "bn.js": "^5.2.5",
    "body-parser": "^2.3.0",
    "cids": "^1.1.9",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "enc-utils": "^3.0.0",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "https": "^1.0.0",
    "ipfs-core-types": "^0.14.1",
    "ipfs-http-client": "^60.0.1",
    "json-colorizer": "^3.0.1",
    "lodash-es": "^4.18.1",
    "node-config-ts": "^3.3.1",
    "node-fetch": "^3.3.2",
    "ts-command-line-args": "^2.5.1",
    "uint8arrays": "^6.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.1",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.13.0"
}
