{
  "name": "@niftyleague/contracts-api",
  "version": "1.0.0",
  "description": "Nifty League Contracts API & Webhooks",
  "repository": "github:NiftyLeague/ContractsAPI.git",
  "main": "dist/api/index.js",
  "bin": {
    "minty": "dist/commander.js"
  },
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/api/index.js",
    "postinstall": "npm run build",
    "dev": "concurrently \"npx tsc --watch\" \"nodemon -q dist/api/index.js\"",
    "test": "ts-node api/test.ts",
    "lint": "eslint --ignore-path .eslintignore . --ext .ts,.js",
    "format": "prettier --ignore-path .prettierignore --write .",
    "onboarding:user-registration": "ts-node -r tsconfig-paths/register -r dotenv/config ./api/scripts/imx/onboarding/1-user-registration.ts",
    "onboarding:create-project": "ts-node -r tsconfig-paths/register -r dotenv/config ./api/scripts/imx/onboarding/2-create-project.ts",
    "onboarding:create-collection": "ts-node -r tsconfig-paths/register -r dotenv/config ./api/scripts/imx/onboarding/3-create-collection.ts",
    "onboarding:add-metadata-schema": "ts-node -r tsconfig-paths/register -r dotenv/config ./api/scripts/imx/onboarding/4-add-metadata-schema.ts",
    "admin:update-metadata-schema": "ts-node -r tsconfig-paths/register -r dotenv/config ./api/scripts/imx/admin/update-metadata-schema.ts"
  },
  "author": "Nifty Andy",
  "license": "MIT",
  "dependencies": {
    "@ethersproject/abstract-signer": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@imtbl/core-sdk": "^1.0.0-beta.3",
    "@imtbl/imlogging": "^1.0.37",
    "@imtbl/imx-sdk": "^1.35.2",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.6",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.8",
    "@nomicfoundation/hardhat-toolbox": "^2.0.1",
    "@nomiclabs/hardhat-ethers": "^2.0.5",
    "@nomiclabs/hardhat-etherscan": "^3.1.6",
    "@pinata/sdk": "^2.1.0",
    "@types/node-fetch": "^2.6.2",
    "aws-sdk": "^2.1313.0",
    "bn.js": "^5.2.1",
    "body-parser": "^1.20.0",
    "config": "^3.3.8",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.8",
    "enc-utils": "^3.0.0",
    "express": "^4.18.2",
    "hardhat": "^2.12.2",
    "https": "^1.0.0",
    "ipfs-core-types": "^0.14.0",
    "ipfs-http-client": "^56.0.1",
    "json-colorizer": "^2.2.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "node-fetch": "^2.6.7",
    "ts-command-line-args": "^2.4.2",
    "uint8arrays": "^3.0.0",
    "web3": "^1.7.3"
  },
  "devDependencies": {
    "@typechain/hardhat": "^6.1.5",
    "@types/config": "^3.3.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.14",
    "@types/lodash": "^4.14.189",
    "@types/node": "^18.11.9",
    "@types/node-fetch": "^2.6.2",
    "@types/request": "^2.48.8",
    "@types/tape": "^4.13.2",
    "@typescript-eslint/eslint-plugin": "^5.42.1",
    "@typescript-eslint/parser": "^5.50.0",
    "chai": "^4.3.7",
    "commander": "^10.0.0",
    "concurrently": "^7.5.0",
    "eslint": "^8.34.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "fp-ts": "^2.13.1",
    "hardhat-gas-reporter": "^1.0.9",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.1",
    "nodemon": "^2.0.20",
    "prettier": "^2.8.4",
    "request": "^2.88.2",
    "solidity-coverage": "^0.8.2",
    "tape": "^5.6.3",
    "ts-migrate": "^0.1.35",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^4.8.4"
  },
  "engines": {
    "node": "16.19.1",
    "npm": "8.19.2"
  }
}
